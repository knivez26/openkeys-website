{
  "name": "OpenPresent",
  "short_name": "OpenPresent",
  "description": "Turn scanned pages into clear, browser-based presentations.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#070707",
  "theme_color": "#070707",
  "orientation": "any",
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }
  ]
}
